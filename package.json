{
  "name": "heimdall",
  "version": "0.1.0",
  "description": "Multi-agent GitHub PR review that shows its evidence: 6 specialists + a consolidator, every finding must cite file:line code or it dies.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "heimdall": "dist/cli.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "install-skill": "node scripts/install-skill.mjs",
    "uninstall-skill": "node scripts/install-skill.mjs --uninstall",
    "heimdall": "tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
