# Active preset: openrouter | anthropic | ollama-local (openrouter is the default)
HEIMDALL_PRESET=openrouter

# Provider credentials (only the one your preset uses is needed)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Global overrides — apply to the active preset (useful for proxies / gateways)
# HEIMDALL_LLM_BASE_URL=
# HEIMDALL_LLM_API_KEY=
